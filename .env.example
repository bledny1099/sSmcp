# ==============================================================================
# sSmcp (socialSimple MCP) Configuration
# Copy this file to .env and fill in the values you need.
# Note: TikTok, Instagram, Threads, and YouTube transcripts work out of the box
# with zero API keys required!
# ==============================================================================

# --- Server & Transport ---
# Options: stdio | http | sse
# Use "stdio" for local desktop clients (Claude Desktop, Cursor, Antigravity)
# Use "http" for remote server deployment
SSMCP_TRANSPORT=http
SSMCP_HOST=127.0.0.1
SSMCP_PORT=8890

# --- Authentication (Remote HTTP/SSE Mode) ---
# Simple static token authentication (Authorization: Bearer <token> or ?token=<token>)
SSMCP_BEARER_TOKEN=

# Optional OAuth 2.1 login screen (for Claude.ai Web / Desktop custom connectors)
SSMCP_PUBLIC_URL=https://mcp.example.com
SSMCP_AUTH_PASSWORD=
SSMCP_GOOGLE_CLIENT_ID=
SSMCP_GOOGLE_CLIENT_SECRET=
SSMCP_ALLOWED_EMAILS=

# --- Whisper Audio Transcription & Keyframe/Slide OCR ---
# Whisper models: tiny | base | small | medium | large-v3
SSMCP_WHISPER_MODEL=small
SSMCP_WHISPER_DEVICE=cpu
SSMCP_WHISPER_COMPUTE_TYPE=int8
SSMCP_WHISPER_CACHE_DIR=/data/whisper
SSMCP_WHISPER_MAX_DURATION=1800

# Visual OCR (Tesseract): reads text from video slides, screenshots, and photo carousels
SSMCP_OCR_ENABLED=true
SSMCP_OCR_LANGUAGES=rus+eng
SSMCP_OCR_MAX_FRAMES=16

# --- Network & Anti-Block (Optional) ---
# Optional HTTP/SOCKS5 proxy for TikTok / Instagram / YouTube requests
# Example: socks5://user:pass@127.0.0.1:1080 or http://127.0.0.1:8080
SSMCP_PROXY=
# Optional Netscape cookies.txt path for age-restricted or region-locked content
SSMCP_COOKIES_FILE=

# --- TikTok Media Publishing (Optional, for tiktok_publish_video tool) ---
# Mode: "local" (copies files to a local web root) or "scp" (uploads to a remote host)
SSMCP_UPLOAD_MODE=local
SSMCP_UPLOAD_LOCAL_DIR=/var/www/uploads
SSMCP_UPLOAD_PUBLIC_URL_PREFIX=https://cdn.example.com/uploads
# Only needed if SSMCP_UPLOAD_MODE=scp:
SSMCP_UPLOAD_SSH_HOST=
SSMCP_UPLOAD_SSH_PORT=22
SSMCP_UPLOAD_SSH_USER=root
SSMCP_UPLOAD_SSH_KEY=
SSMCP_UPLOAD_REMOTE_DIR=/var/www/uploads

# --- YouTube Data API v3 (Optional, for search & playlist management) ---
# Note: youtube_get_transcript works WITHOUT any YouTube API keys.
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YT_DAILY_QUOTA_LIMIT=10000
YT_QUOTA_WARN_THRESHOLD=8000
YT_QUOTA_STATE_PATH=/data/quota_state.json
